  [неизвестный тип], [ошибка разбора, ответ `ERROR`],
  [дубликат], [`DUP`, повторная обработка не выполняется],
  [TTL = 0], [`DROP_TTL`],
  [нет маршрута], [`NO_ROUTE`],
)

Основа обработки частичного приёма:

```cpp
IoResult recv_exact(int fd, char* buffer, std::size_t length,
                    std::string& error) {
    std::size_t total = 0;
    while (total < length) {
        const ssize_t received =
            ::recv(fd, buffer + total, length - total, 0);
        if (received > 0) {
            total += static_cast<std::size_t>(received);
            continue;
        }
        if (received == 0) return IoResult::Closed;
        if (errno == EINTR) continue;
        if (errno == EAGAIN || errno == EWOULDBLOCK) {
            return total == 0 ? IoResult::Timeout : IoResult::Error;
        }
        error = std::string("recv: ") + std::strerror(errno);
        return IoResult::Error;
    }
    return IoResult::Ok;
}
```

