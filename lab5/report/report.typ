Кадрирование и частичная отправка:

```cpp
bool send_all(int fd, const char* data, std::size_t length,
              std::string& error) {
    std::size_t total = 0;
    while (total < length) {
        const ssize_t sent =
            ::send(fd, data + total, length - total, MSG_NOSIGNAL);
        if (sent > 0) { total += static_cast<std::size_t>(sent); continue; }
        if (sent < 0 && errno == EINTR) continue;
        error = std::string("send: ") + std::strerror(errno);
        return false;
    }
    return true;
}
```

Проверка дубликатов и пересылка:

```cpp
